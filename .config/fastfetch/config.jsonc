{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
        "type": "display",
        "format": "{inch}\" {width}x{height}@{refresh-rate}Hz"
    },
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "cpu",
    {
        "type": "gpu",
        "format": "{vendor} Vega Series"
    },
    "memory",
    "swap",
    {
        "type": "disk",
        "format": "{size-used} / {size-total} ({size-percentage})"
    },
    "localip",
    {
        "type": "battery",
        "format": "{capacity}"
    },
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
